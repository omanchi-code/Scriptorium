# ── Database (required — powers login + Studio history) ──────────────────
# A free Postgres works fine: Neon, Supabase, or Vercel Postgres all have
# no-cost tiers. Paste the connection string they give you.
DATABASE_URL=

# ── Auth (required — gates /studio and its API routes) ────────────────────
# Generate a random secret: `npx auth secret` (writes it for you) or
# `openssl rand -base64 33`
AUTH_SECRET=

# The one admin account. Set these, then run `npm run seed` once to create
# the account in the database. Change ADMIN_PASSWORD and re-run `npm run
# seed` any time to reset it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Text generation (required — 8 of 10 Studio outputs) ───────────────────
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# ── Cinematic Artwork ───────────────────────────────────────────────────
# Free via Pollinations.ai — no key needed, nothing to set here.

# ── Book Trailer (required for that one output — video via Runway) ────────
# Get a key from https://dev.runwayml.com
RUNWAY_API_KEY=

# Optional — override if Runway renames/retires these model slugs.
# Check your Runway developer dashboard for current model names.
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4_turbo
RUNWAY_API_VERSION=2024-11-06
